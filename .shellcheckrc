# Repo-wide ShellCheck policy. ShellCheck looks for .shellcheckrc in each
# script's directory and then up the parent directories.
#
# The dialect is declared once here for every script, so it never depends on
# each file carrying a shebang (sourced snippets may have none).
shell=bash

# Every optional rule is on. Warnings that reflect deliberate patterns are
# silenced inline with documented `# shellcheck disable=` comments instead of
# being turned off repo-wide.
enable=add-default-case,avoid-nullary-conditions,check-extra-masked-returns,check-set-e-suppressed,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-double-brackets,require-variable-braces

# DevOps scripts commonly source files whose paths are only known at runtime
# from the environment (env files, profile snippets), which ShellCheck can
# never follow statically.
disable=SC1090,SC1091
